{
  "CheckCreated": {
    "$defs": {
      "JobStatus": {
        "enum": [
          "queued",
          "in_progress",
          "completed",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      }
    },
    "description": "POST /checks 응답",
    "properties": {
      "job_id": {
        "title": "Job Id",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/JobStatus"
      }
    },
    "required": [
      "job_id",
      "status"
    ],
    "title": "CheckCreated",
    "type": "object"
  },
  "CheckResult": {
    "$defs": {
      "Decision": {
        "enum": [
          "특혜 적용",
          "보완 요청",
          "미적용",
          "검토 필요"
        ],
        "title": "Decision",
        "type": "string"
      },
      "FollowUp": {
        "properties": {
          "kind": {
            "enum": [
              "보완_요청_초안",
              "미적용_안내",
              "검토_메모",
              "미분류_안내"
            ],
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "title": "FollowUp",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "in_progress",
          "completed",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "JudgeResult": {
        "description": "판정 노드 출력 5키. answer.json 키와 같다.",
        "properties": {
          "invoice_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice No"
          },
          "decision": {
            "$ref": "#/$defs/Decision"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "mismatch_codes": {
            "items": {
              "type": "string"
            },
            "title": "Mismatch Codes",
            "type": "array"
          },
          "missing_documents": {
            "items": {
              "type": "string"
            },
            "title": "Missing Documents",
            "type": "array"
          }
        },
        "required": [
          "invoice_no",
          "decision",
          "reason",
          "mismatch_codes",
          "missing_documents"
        ],
        "title": "JudgeResult",
        "type": "object"
      },
      "MismatchItem": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "1 미적용 / 2 보완 요청 / 3 검토 필요. 모르는 코드면 null",
            "title": "Stage"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "code",
          "label"
        ],
        "title": "MismatchItem",
        "type": "object"
      }
    },
    "description": "GET /checks/{job_id} 응답. 완료 전에는 judge·follow_up이 null.",
    "properties": {
      "job_id": {
        "title": "Job Id",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/JobStatus"
      },
      "judge": {
        "anyOf": [
          {
            "$ref": "#/$defs/JudgeResult"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "mismatches": {
        "default": [],
        "items": {
          "$ref": "#/$defs/MismatchItem"
        },
        "title": "Mismatches",
        "type": "array"
      },
      "follow_up": {
        "anyOf": [
          {
            "$ref": "#/$defs/FollowUp"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "extracted": {
        "additionalProperties": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "description": "Extract 노드 이름 → 서류별 추출 JSON 목록(같은 종류 2건이면 2개)",
        "title": "Extracted",
        "type": "object"
      },
      "extracted_meta": {
        "additionalProperties": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "description": "extracted와 같은 모양. 필드마다 {confidence: high|medium|low, score: 0~1, page: 1부터(-1=위치 없음), boxes: [[{x,y}×4], …] 페이지 기준 0~1 비율 좌표(단어별)}. items는 품목별 같은 구조의 목록",
        "title": "Extracted Meta",
        "type": "object"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      }
    },
    "required": [
      "job_id",
      "status"
    ],
    "title": "CheckResult",
    "type": "object"
  }
}
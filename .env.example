# cp .env.example .env 후 값을 채운다. .env 는 저장소에 올리지 않는다.
# 백엔드(backend/)는 ../.env 를 읽고, compose.yaml 도 이 파일을 읽는다.

# ---- DB (compose.yaml 의 MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=origin_check
DB_USERNAME=origin_check
DB_PASSWORD=origin_check
DB_ROOT_PASSWORD=root

# ---- 인증 ----
# 32자 이상 무작위 문자열. 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_MIN=60
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- AI agent ----
# upstage: Upstage 호출 / fake: AGENT_FAKE_RESULT 의 JSON 을 AGENT_FAKE_DELAY 뒤에 결과로 돌려줌
AGENT_MODE=upstage
# AGENT_FAKE_RESULT=src/test/resources/check_result_set04.json
# AGENT_FAKE_DELAY=10s
# AGENT_POLL_INTERVAL_MS=5000
# AGENT_TIMEOUT=30m

UPSTAGE_API_KEY=
# 기본값을 바꿀 때만
# UPSTAGE_PROJECT_ID=
# UPSTAGE_AGENT_ID=
# UPSTAGE_CONFIG_ID=

# ---- 파일 ----
# STORAGE_DIR=./data/uploads
